PORT=8787
PUBLIC_BASE_URL=https://sleep.example.com
DATA_DIR=./data

# Generate each value independently with: openssl rand -hex 32
ANDROID_DEVICE_TOKEN=replace-with-a-random-device-token
CODEX_CONTROL_TOKEN=replace-with-a-random-codex-token

# Entered only on the OAuth approval page when connecting ChatGPT/Codex.
# Use a long private phrase, not a short numeric PIN.
OWNER_APPROVAL_CODE=replace-with-a-long-private-approval-phrase

WAKE_HOUR=6
WAKE_MINUTE=30
AUTO_START_HOUR=1
UTC_OFFSET_MINUTES=480
ACCESS_TOKEN_TTL_DAYS=90
